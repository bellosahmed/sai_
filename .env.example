# Use a DIFFERENT database here than the one the test suite uses.
# The tests wipe their database on every run (see tests/setup.ts, which
# defaults to a DB named `qrtickets_test`), so point dev/prod at its own DB
# (e.g. `qrtickets_dev` locally) to avoid losing your data.
DATABASE_URL="postgresql://USER:PASS@HOST:5432/DBNAME"
SESSION_SECRET="generate-with: openssl rand -base64 48"
